---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="bg-wellness flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] p-8 text-center text-[#1F1F1A] shadow-[0_10px_24px_rgba(79,90,55,0.08)]"
    >
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 text-2xl font-bold text-[#4F5A37]">
        {content.heading}
      </h1>
      <p class="mb-6 text-[#67675F]">{content.description}</p>
      <a href="/auth/signin" class="text-sm text-[#4F5A37] hover:text-[#97A354] hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
