---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="bg-wellness flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] p-8 text-[#1F1F1A] shadow-[0_10px_24px_rgba(79,90,55,0.08)]"
    >
      <h1 class="mb-6 text-center text-2xl font-bold text-[#4F5A37]">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-[#67675F]">
        Already have an account? <a href="/auth/signin" class="text-[#4F5A37] hover:text-[#97A354] hover:underline"
          >Sign in</a
        >
      </p>
    </div>
  </div>
</Layout>
