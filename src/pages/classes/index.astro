---
import ClassCard from "@/components/classes/ClassCard.astro";
import { listUpcomingClasses } from "@/lib/classes.handler";
import Layout from "@/layouts/Layout.astro";

const result = await listUpcomingClasses();
---

<Layout title="Upcoming classes">
  <main class="bg-wellness min-h-screen px-4 py-10 sm:px-6">
    <section class="mx-auto max-w-5xl">
      <header class="mb-8">
        <p class="text-sm font-medium tracking-wide text-[#4F5A37] uppercase">FitSpot schedule</p>
        <h1 class="mt-2 text-3xl font-bold text-[#1F1F1A] sm:text-4xl">Upcoming classes</h1>
        <p class="mt-3 max-w-2xl text-base text-[#67675F]">
          Browse sessions with real-time availability and pick the class that matches your pace.
        </p>
      </header>

      {
        result.ok ? (
          result.data.length > 0 ? (
            <div class="grid gap-6 md:grid-cols-2">
              {result.data.map((classItem) => (
                <ClassCard classItem={classItem} />
              ))}
            </div>
          ) : (
            <div class="rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] p-8 text-center text-[#67675F]">
              <p class="font-medium text-[#1F1F1A]">No upcoming classes yet</p>
              <p class="mt-2 text-sm">Please check back soon for new sessions.</p>
            </div>
          )
        ) : (
          <div
            class="rounded-2xl border border-[#C95B5B]/30 bg-[#FFFFFF] p-8 text-[#C95B5B]"
            role="status"
            aria-live="polite"
          >
            <p class="font-semibold">We could not load classes right now.</p>
            <p class="mt-2 text-sm">Please refresh in a moment.</p>
          </div>
        )
      }
    </section>
  </main>
</Layout>
