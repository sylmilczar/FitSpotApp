---
import UpcomingReservationsPanel from "@/components/classes/UpcomingReservationsPanel.astro";
import Topbar from "@/components/Topbar.astro";
import { getUserUpcomingReservations } from "@/lib/booking.handler";
import type { ClassListItem } from "@/types";
import { listUpcomingClasses } from "@/lib/classes.handler";
import { createClient } from "@/lib/supabase";
import Layout from "@/layouts/Layout.astro";

const result = await listUpcomingClasses();
const currentUser = Astro.locals.user;

const reservedClassIds = new Set<string>();
let upcomingReservationsLoadState: "idle" | "ok" | "error" = "idle";
let upcomingReservationsErrorMessage = "";
let upcomingReservations = [];

if (currentUser) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);

  if (supabase) {
    const upcomingReservationsResult = await getUserUpcomingReservations(supabase, currentUser.id);

    if (upcomingReservationsResult.ok) {
      upcomingReservationsLoadState = "ok";
      upcomingReservations = upcomingReservationsResult.data;
      for (const reservation of upcomingReservationsResult.data) {
        reservedClassIds.add(reservation.classId);
      }
    } else {
      upcomingReservationsLoadState = "error";
      upcomingReservationsErrorMessage = upcomingReservationsResult.message;
    }
  } else {
    upcomingReservationsLoadState = "error";
    upcomingReservationsErrorMessage = "Could not initialize reservations data.";
  }
}

const hours = Array.from({ length: 14 }, (_, idx) => idx + 8);
const dayStart = new Date();
dayStart.setHours(0, 0, 0, 0);

const days = Array.from({ length: 7 }, (_, idx) => {
  const date = new Date(dayStart);
  date.setDate(dayStart.getDate() + idx);
  return {
    date,
    key: `${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`,
    label: new Intl.DateTimeFormat("en-US", {
      weekday: "short",
      day: "numeric",
      month: "short",
    }).format(date),
  };
});

function getClassCellItems(classes: ClassListItem[], day: Date, hour: number) {
  return classes.filter((classItem) => {
    const startsAt = new Date(classItem.startsAt);

    return (
      startsAt.getFullYear() === day.getFullYear() &&
      startsAt.getMonth() === day.getMonth() &&
      startsAt.getDate() === day.getDate() &&
      startsAt.getHours() === hour
    );
  });
}

function formatHour(hour: number) {
  return `${hour.toString().padStart(2, "0")}:00`;
}

function formatClassTime(startsAtIso: string) {
  return new Intl.DateTimeFormat("en-US", {
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(startsAtIso));
}
---

<Layout title="Upcoming classes">
  <main class="bg-wellness min-h-screen px-4 py-10 sm:px-6">
    <section class="mx-auto max-w-5xl">
      <Topbar variant="light" />

      <header class="mb-8">
        <p class="text-sm font-medium tracking-wide text-[#4F5A37] uppercase">FitSpot schedule</p>
        <h1 class="mt-2 text-3xl font-bold text-[#1F1F1A] sm:text-4xl">Upcoming classes</h1>
        <p class="mt-3 max-w-2xl text-base text-[#67675F]">
          Browse sessions with real-time availability and pick the class that matches your pace.
        </p>
      </header>

      {
        currentUser && upcomingReservationsLoadState === "ok" ? (
          <UpcomingReservationsPanel reservations={upcomingReservations} />
        ) : null
      }

      {
        currentUser && upcomingReservationsLoadState === "error" ? (
          <section class="mb-8 rounded-2xl border border-[#D7A441]/30 bg-[#FFF8EB] p-6 text-[#7A5A1F]">
            <h2 class="text-lg font-semibold">My upcoming reservations</h2>
            <p class="mt-2 text-sm">Could not load your reservations right now. Please refresh in a moment.</p>
            {upcomingReservationsErrorMessage ? (
              <p class="mt-2 text-xs opacity-70">{upcomingReservationsErrorMessage}</p>
            ) : null}
          </section>
        ) : null
      }

      {
        result.ok ? (
          <>
            <div class="max-h-[70vh] overflow-auto rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] shadow-[0_10px_24px_rgba(79,90,55,0.08)]">
              <table class="w-full min-w-[820px] border-collapse text-xs">
                <thead class="sticky top-0 z-20">
                  <tr class="border-b border-[#E6E6DD] bg-[#F8F8F5]">
                    <th class="w-20 border-r border-[#EEEEEA] px-3 py-2 text-left font-semibold text-[#4F5A37]">
                      Hour
                    </th>

                    {days.map((day, index) => (
                      <th
                        class:list={[
                          "min-w-[105px] px-3 py-2 text-left font-semibold text-[#4F5A37]",
                          index < days.length - 1 ? "border-r border-[#EEEEEA]" : "",
                        ]}
                      >
                        {day.label}
                      </th>
                    ))}
                  </tr>
                </thead>

                <tbody>
                  {hours.map((hour) => (
                    <tr class="border-b border-[#EEEEDD] align-top last:border-b-0">
                      <th class="border-r border-[#EEEEEA] px-3 py-2 text-left font-semibold text-[#67675F]">
                        {formatHour(hour)}
                      </th>

                      {days.map((day, index) => {
                        const classesInCell = getClassCellItems(result.data, day.date, hour);

                        return (
                          <td class:list={["px-2 py-2", index < days.length - 1 ? "border-r border-[#EEEEEA]" : ""]}>
                            {classesInCell.length > 0 ? (
                              <div class="space-y-1.5">
                                {classesInCell.map((classItem) => {
                                  const isUnavailable = classItem.isStarted || classItem.isFull;
                                  const isReserved = reservedClassIds.has(classItem.id);

                                  return (
                                    <a
                                      href={`/classes/${classItem.id}`}
                                      class:list={[
                                        "block rounded-lg border px-2.5 py-1.5 transition-colors",
                                        isUnavailable
                                          ? "border-[#D7A441]/40 bg-[#D7A441]/10 text-[#7A5A1F]"
                                          : "border-[#D9DEB8] bg-[#D9DEB8]/35 text-[#4F5A37] hover:bg-[#D9DEB8]/55",
                                      ]}
                                    >
                                      <p class="text-[10px] font-semibold tracking-wide uppercase">
                                        {formatClassTime(classItem.startsAt)}
                                      </p>

                                      <p class="mt-0.5 flex items-center gap-1 text-xs leading-tight font-semibold">
                                        <span>{classItem.name}</span>

                                        {isReserved ? (
                                          <span title="Reserved" aria-label="Reserved">
                                            ☑️
                                          </span>
                                        ) : null}
                                      </p>

                                      <p class="mt-0.5 text-[10px] leading-tight">
                                        {isUnavailable
                                          ? "Unavailable"
                                          : `${classItem.availableSpots}/${classItem.capacity} available`}
                                      </p>
                                    </a>
                                  );
                                })}
                              </div>
                            ) : (
                              <div class="px-2 py-2 text-center text-[10px] text-[#B0B0A8]">-</div>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {result.data.length === 0 ? (
              <div class="mt-6 rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] p-8 text-center text-[#67675F]">
                <p class="font-medium text-[#1F1F1A]">No classes in the next 7 days</p>
                <p class="mt-2 text-sm">Try checking back later for new sessions.</p>
              </div>
            ) : null}
          </>
        ) : (
          <div
            class="rounded-2xl border border-[#C95B5B]/30 bg-[#FFFFFF] p-8 text-[#C95B5B]"
            role="status"
            aria-live="polite"
          >
            <p class="font-semibold">We could not load classes right now.</p>
            <p class="mt-2 text-sm">Please refresh in a moment.</p>
          </div>
        )
      }
    </section>
  </main>
</Layout>
