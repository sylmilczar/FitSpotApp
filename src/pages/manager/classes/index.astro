---
import ClassList from "@/components/manager/ClassList.astro";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { listManagerClasses } from "@/lib/classes.mutation.handler";
import { createClient } from "@/lib/supabase";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase
  ? await listManagerClasses(supabase)
  : { ok: false as const, code: "CONFIG_ERROR", message: "Supabase is not configured." };
const resultCode = Astro.url.searchParams.get("result");

const nowMs = Date.now();
const currentClasses = result.ok
  ? result.data
      .filter((classItem) => new Date(classItem.startsAt).getTime() > nowMs)
      .sort((a, b) => new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime())
  : [];
const archivedClasses = result.ok
  ? result.data
      .filter((classItem) => new Date(classItem.startsAt).getTime() <= nowMs)
      .sort((a, b) => new Date(b.startsAt).getTime() - new Date(a.startsAt).getTime())
  : [];

const resultFeedbackByCode: Record<string, { message: string; tone: "success" | "error" }> = {
  CREATED: { message: "Class created successfully.", tone: "success" },
  UPDATED: { message: "Class updated successfully.", tone: "success" },
  DELETED: { message: "Class deleted successfully.", tone: "success" },
  CANCELLED: { message: "Class cancelled successfully.", tone: "success" },
  CONFIG_ERROR: { message: "Configuration issue. Please contact support.", tone: "error" },
  DATABASE_ERROR: { message: "Database error. Please try again in a moment.", tone: "error" },
  VALIDATION_ERROR: { message: "Some class data is invalid. Please review the form.", tone: "error" },
  INVALID_FORMAT: { message: "Enter a valid class date and time.", tone: "error" },
  PAST_DATE: { message: "Class must start in the future.", tone: "error" },
  CAPACITY_BELOW_RESERVATIONS: {
    message: "Capacity cannot be lower than confirmed reservations.",
    tone: "error",
  },
  STARTS_AT_LOCKED: {
    message: "Start date and time cannot be changed while the class has confirmed reservations.",
    tone: "error",
  },
  HAS_RESERVATIONS: {
    message: "This class has reservations, so it cannot be deleted. Cancel it instead.",
    tone: "error",
  },
};

const resultFeedback = resultCode
  ? (resultFeedbackByCode[resultCode] ?? {
      message: "Operation could not be completed. Please try again.",
      tone: "error" as const,
    })
  : null;
---

<Layout title="Manage classes">
  <main class="bg-wellness min-h-screen px-4 py-10 sm:px-6">
    <section class="mx-auto max-w-4xl">
      <Topbar variant="light" />
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium tracking-wide text-[#4F5A37] uppercase">Staff workspace</p><h1
            class="mt-2 text-3xl font-bold text-[#1F1F1A]"
          >
            Manage classes
          </h1>
        </div>
        <a href="/manager/classes/new" class="rounded-xl bg-[#4F5A37] px-4 py-2 text-sm font-semibold text-white"
          >New class</a
        >
      </div>
      {
        resultFeedback ? (
          <p
            class:list={[
              "mb-5 rounded-xl border px-4 py-3 text-sm",
              resultFeedback.tone === "success"
                ? "border-[#D9DEB8] bg-[#EDF3DF] text-[#3E4A2A]"
                : "border-[#C95B5B]/30 bg-[#FFF0F0] text-[#8E4040]",
            ]}
          >
            {resultFeedback.message}
          </p>
        ) : null
      }
      {
        result.ok ? (
          <div class="space-y-8">
            <section>
              <h2 class="mb-3 text-xl font-semibold text-[#1F1F1A]">Current classes</h2>
              <ClassList classes={currentClasses} />
            </section>

            <section>
              <h2 class="mb-3 text-xl font-semibold text-[#1F1F1A]">Archived classes</h2>
              <ClassList classes={archivedClasses} />
            </section>
          </div>
        ) : (
          <p class="rounded-xl border border-[#C95B5B]/30 bg-white p-5 text-[#8E4040]">{result.message}</p>
        )
      }
    </section>
  </main>
</Layout>
