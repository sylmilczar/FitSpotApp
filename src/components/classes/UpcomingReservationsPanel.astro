---
import type { UpcomingReservationItem } from "@/types";

interface Props {
  reservations: UpcomingReservationItem[];
}

const { reservations } = Astro.props;

function formatDateLabel(startsAtIso: string): string {
  return new Intl.DateTimeFormat("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "UTC",
  }).format(new Date(startsAtIso));
}
---

<section class="mb-8 rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] p-6 shadow-[0_10px_24px_rgba(79,90,55,0.08)]">
  <header class="mb-4">
    <h2 class="text-xl font-bold text-[#1F1F1A]">My upcoming reservations</h2>
    <p class="mt-1 text-sm text-[#67675F]">Your confirmed spots in the next 7 days.</p>
  </header>

  {
    reservations.length === 0 ? (
      <div class="rounded-xl border border-[#E6E6DD] bg-[#F8F8F5] p-4 text-sm text-[#67675F]">
        You have no upcoming reservations yet.
      </div>
    ) : (
      <ul class="space-y-3">
        {reservations.map((reservation) => (
          <li class="rounded-xl border border-[#D9DEB8] bg-[#F7FAEF] p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-[#1F1F1A]">{reservation.className}</p>
                <p class="mt-1 text-xs text-[#67675F]">{formatDateLabel(reservation.startsAt)}</p>
              </div>
              <span class="inline-flex items-center rounded-lg border border-[#4F5A37]/20 bg-[#4F5A37]/10 px-2 py-1 text-xs font-semibold text-[#3E4A2A]">
                Confirmed
              </span>
            </div>
            <p class="mt-2 text-xs text-[#67675F]">{reservation.availableSpots}/{reservation.capacity} spots currently available</p>
          </li>
        ))}
      </ul>
    )
  }
</section>
