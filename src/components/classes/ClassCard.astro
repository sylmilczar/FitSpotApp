---
import type { ClassListItem } from "@/types";
import ClassStatusBadge from "@/components/classes/ClassStatusBadge.astro";

interface Props {
  classItem: ClassListItem;
}

const { classItem } = Astro.props;
const date = new Date(classItem.startsAt);

const dateLabel = new Intl.DateTimeFormat("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
}).format(date);
---

<article class="rounded-2xl border border-[#E6E6DD] bg-[#FFFFFF] p-6 shadow-[0_10px_24px_rgba(79,90,55,0.08)]">
  <div class="mb-4 flex items-start justify-between gap-4">
    <div>
      <h2 class="text-xl font-semibold text-[#1F1F1A]">{classItem.name}</h2>
      <p class="mt-1 text-sm text-[#67675F]">{dateLabel}</p>
    </div>
    <ClassStatusBadge availabilityStatus={classItem.isFull ? "full" : "available"} />
  </div>

  <p class="mb-6 text-sm leading-6 text-[#67675F]">{classItem.description ?? "Class details will be shared soon."}</p>

  <div class="mb-6 flex flex-wrap gap-4 text-sm text-[#4F5A37]">
    <p><span class="font-semibold">Available:</span> {classItem.availableSpots}</p>
    <p><span class="font-semibold">Capacity:</span> {classItem.capacity}</p>
  </div>

  <a
    href={`/classes/${classItem.id}`}
    class="inline-flex items-center justify-center rounded-2xl border border-[#ADB867] bg-[#ADB867] px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-[#97A354] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ADB867]"
  >
    View details
  </a>
</article>
