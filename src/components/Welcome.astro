---
import Topbar from "@/components/Topbar.astro";

const signInHref = "/auth/signin?returnTo=%2F";
const signUpHref = "/auth/signup?returnTo=%2F";
---

<main class="bg-wellness min-h-screen px-4 py-6 sm:px-6 sm:py-8">
  <section class="mx-auto max-w-5xl">
    <Topbar variant="light" />

    <div class="rounded-3xl border border-[#D9DEB8] bg-[#F8F8F5] p-8 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <p
            class="inline-flex rounded-full border border-[#C9D09A] bg-[#EEF1DB] px-3 py-1 text-xs font-semibold tracking-[0.18em] text-[#4F5A37] uppercase"
          >
            FitSpot Club
          </p>
          <h1 class="mt-5 max-w-xl text-4xl leading-tight font-bold text-[#1F1F1A] sm:text-5xl">
            Train consistently without booking chaos.
          </h1>
          <p class="mt-4 max-w-xl text-base text-[#67675F] sm:text-lg">
            FitSpot is a boutique fitness club where you can quickly check class schedules and reserve your spot.
          </p>
          <div class="mt-5 flex flex-wrap gap-3 text-sm font-medium text-[#4F5A37]">
            <span class="rounded-lg border border-[#D9DEB8] bg-white px-3 py-2">Small group coaching</span>
            <span class="rounded-lg border border-[#D9DEB8] bg-white px-3 py-2">Fast online booking</span>
            <span class="rounded-lg border border-[#D9DEB8] bg-white px-3 py-2">7 days schedule access</span>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/classes"
              class="inline-flex items-center justify-center rounded-xl bg-[#4F5A37] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#3E472B]"
            >
              Browse classes
            </a>
            <a
              href={signInHref}
              class="inline-flex items-center justify-center rounded-xl border border-[#C9D09A] bg-white px-5 py-3 text-sm font-semibold text-[#4F5A37] transition-colors hover:bg-[#F2F4E8]"
            >
              Sign in
            </a>
            <a
              href={signUpHref}
              class="inline-flex items-center justify-center rounded-xl border border-transparent px-5 py-3 text-sm font-semibold text-[#4F5A37] transition-colors hover:bg-[#EEF1DB]"
            >
              Sign up
            </a>
          </div>

          <dl class="mt-8 grid max-w-xl grid-cols-3 gap-3">
            <div class="rounded-xl border border-[#E0E5C0] bg-white p-3">
              <dt class="text-xs font-medium text-[#67675F]">Slots</dt>
              <dd class="mt-1 text-xl font-bold text-[#1F1F1A]">Live</dd>
            </div>
            <div class="rounded-xl border border-[#E0E5C0] bg-white p-3">
              <dt class="text-xs font-medium text-[#67675F]">Booking</dt>
              <dd class="mt-1 text-xl font-bold text-[#1F1F1A]">24/7</dd>
            </div>
            <div class="rounded-xl border border-[#E0E5C0] bg-white p-3">
              <dt class="text-xs font-medium text-[#67675F]">Support</dt>
              <dd class="mt-1 text-xl font-bold text-[#1F1F1A]">Direct</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl border border-[#D9DEB8] bg-white p-6 shadow-[0_8px_20px_rgba(79,90,55,0.08)]">
          <h2 class="text-sm font-semibold tracking-wide text-[#4F5A37] uppercase">Contact</h2>
          <p class="mt-3 text-sm text-[#67675F]">Questions about class level or available spots?</p>
          <ul class="mt-4 space-y-2 text-sm text-[#1F1F1A]">
            <li>Phone: +48 600 123 456</li>
            <li>Email: kontakt@fitspot.pl</li>
            <li>Address: ul. Sportowa 12, Gdansk</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-[#E6E6DD] bg-white p-5">
        <h3 class="text-base font-semibold text-[#1F1F1A]">Who we are</h3>
        <p class="mt-2 text-sm text-[#67675F]">
          FitSpot coaches lead small groups and adapt classes to participants' experience level.
        </p>
      </article>
      <article class="rounded-2xl border border-[#E6E6DD] bg-white p-5">
        <h3 class="text-base font-semibold text-[#1F1F1A]">How it works</h3>
        <p class="mt-2 text-sm text-[#67675F]">
          Check availability, reserve online, and instantly see your booking confirmation.
        </p>
      </article>
      <article class="rounded-2xl border border-[#E6E6DD] bg-white p-5">
        <h3 class="text-base font-semibold text-[#1F1F1A]">Who it is for</h3>
        <p class="mt-2 text-sm text-[#67675F]">
          For people who want to train regularly and keep quick, simple access to the class schedule.
        </p>
      </article>
    </div>
  </section>
</main>
