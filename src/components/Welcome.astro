---
import Topbar from "@/components/Topbar.astro";
---

<main class="bg-wellness min-h-screen px-4 py-6 sm:px-6 sm:py-8">
  <section class="mx-auto max-w-6xl">
    <Topbar variant="light" />

    <!-- Hero -->
    <section class="rounded-3xl border border-[#D9DEB8] bg-[#F8F8F5] p-7 sm:p-10">
      <div>
        <p
          class="inline-flex rounded-full border border-[#C9D09A] bg-[#EEF1DB] px-3 py-1 text-xs font-semibold tracking-[0.18em] text-[#4F5A37] uppercase"
        >
          FitSpot Club
        </p>

        <h1 class="mt-3 text-4xl leading-tight font-bold text-[#1F1F1A]">Train consistently without booking chaos.</h1>

        <p class="mt-2 text-base leading-7 text-[#67675F] sm:text-lg">
          Quickly check the class schedule, see available spots, and reserve your place online.
        </p>

        <!-- Primary action -->
        <div class="mt-7 flex w-full justify-center">
          <a
            href="/classes"
            class="inline-flex w-full items-center justify-center rounded-lg bg-[#4F5A37] px-8 py-2.5 text-base font-semibold text-white transition-colors hover:bg-[#3E472B]"
          >
            Browse classes
          </a>
        </div>
      </div>

      <!-- Benefits -->
      <div class="mx-auto mt-10 grid max-w-2xl grid-cols-3 border-t border-[#E0E5C0] pt-6 text-center">
        <div class="pr-4">
          <span>✓ Small group coaching</span>
        </div>

        <div class="border-l border-[#E0E5C0] px-4">
          <span>✓ Fast online booking</span>
        </div>

        <div class="border-l border-[#E0E5C0] pl-4">
          <span>✓ 7-day schedule access</span>
        </div>
      </div>
    </section>

    <!-- Information -->
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-[#E6E6DD] bg-white p-5">
        <h3 class="text-base font-semibold text-[#1F1F1A]">Who we are</h3>
        <p class="mt-2 text-sm text-[#67675F]">
          FitSpot coaches lead small groups and adapt classes to participants' experience level.
        </p>
      </article>
      <article class="rounded-2xl border border-[#E6E6DD] bg-white p-5">
        <h3 class="text-base font-semibold text-[#1F1F1A]">How it works</h3>
        <p class="mt-2 text-sm text-[#67675F]">
          Check availability, reserve online, and instantly see your booking confirmation.
        </p>
      </article>
      <article class="rounded-2xl border border-[#E6E6DD] bg-white p-5">
        <h3 class="text-base font-semibold text-[#1F1F1A]">Who it is for</h3>
        <p class="mt-2 text-sm text-[#67675F]">
          For people who want to train regularly and keep quick, simple access to the class schedule.
        </p>
      </article>
    </div>

    <!-- Contact -->
    <section class="mt-8 border-t border-[#E0E5C0] pt-6">
      <div class="flex flex-col gap-2 text-sm sm:flex-row sm:items-center sm:gap-6">
        <p class="font-semibold tracking-wide text-[#4F5A37] uppercase">Contact</p>
        <a href="tel:+48600123456" class="transition-colors hover:text-[#4F5A37]"> +48 600 123 456 </a>
        <a href="mailto:kontakt@fitspot.pl" class="transition-colors hover:text-[#4F5A37]"> kontakt@fitspot.pl </a>
        <span>ul. Sportowa 12, Gdansk</span>
      </div>
    </section>
  </section>
</main>
