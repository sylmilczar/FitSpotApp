---
interface Props {
  action: string;
  submitLabel: string;
  className?: string;
  description?: string | null;
  capacity?: number;
  startsAt?: string;
  minCapacity?: number;
  lockStartsAt?: boolean;
  error?: string | null;
}

const {
  action,
  submitLabel,
  className = "",
  description = "",
  capacity = 10,
  startsAt = "",
  minCapacity = 1,
  lockStartsAt = false,
  error = null,
} = Astro.props;

function toDateTimeLocalValue(value: string): string {
  const trimmedValue = value.trim();

  if (!trimmedValue) {
    return "";
  }

  const date = new Date(trimmedValue);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  const pad = (num: number) => String(num).padStart(2, "0");
  const year = date.getFullYear();
  const month = pad(date.getMonth() + 1);
  const day = pad(date.getDate());
  const hours = pad(date.getHours());
  const minutes = pad(date.getMinutes());

  return `${year}-${month}-${day}T${hours}:${minutes}`;
}

const localStartsAt = toDateTimeLocalValue(startsAt);
---

<form
  method="post"
  action={action}
  class="space-y-5 rounded-2xl border border-[#E6E6DD] bg-white p-6 shadow-[0_10px_24px_rgba(79,90,55,0.08)]"
>
  {
    error ? (
      <p class="rounded-xl border border-[#C95B5B]/30 bg-[#FFF0F0] px-4 py-3 text-sm text-[#8E4040]">{error}</p>
    ) : null
  }
  <label class="block text-sm font-medium text-[#1F1F1A]">
    Class name
    <input
      name="className"
      required
      maxlength="120"
      value={className}
      class="mt-2 w-full rounded-xl border border-[#D9DEB8] px-3 py-2"
    />
  </label>
  <label class="block text-sm font-medium text-[#1F1F1A]">
    Description
    <textarea
      name="description"
      maxlength="2000"
      rows="4"
      class="mt-2 w-full rounded-xl border border-[#D9DEB8] px-3 py-2">{description}</textarea
    >
  </label>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-medium text-[#1F1F1A]">
      Capacity
      <input
        name="capacity"
        required
        min={minCapacity}
        type="number"
        value={capacity}
        class="mt-2 w-full rounded-xl border border-[#D9DEB8] px-3 py-2"
      />
      {
        minCapacity > 1 ? (
          <p class="mt-1 text-xs text-[#67675F]">Capacity cannot be lower than {minCapacity} active reservations.</p>
        ) : null
      }
    </label>
    <label class="block text-sm font-medium text-[#1F1F1A]">
      Starts at
      <input
        name="startsAt"
        required
        type="datetime-local"
        value={localStartsAt}
        readonly={lockStartsAt}
        aria-readonly={lockStartsAt}
        class:list={[
          "mt-2 w-full rounded-xl border border-[#D9DEB8] px-3 py-2",
          lockStartsAt ? "bg-[#F8F8F5] text-[#67675F]" : "",
        ]}
      />
      {
        lockStartsAt ? (
          <p class="mt-1 text-xs text-[#67675F]">
            Start date and time cannot be changed while the class has active reservations.
          </p>
        ) : null
      }
    </label>
  </div>
  <button type="submit" class="rounded-xl bg-[#4F5A37] px-4 py-2 text-sm font-semibold text-white hover:bg-[#3E4A2A]"
    >{submitLabel}</button
  >
</form>
